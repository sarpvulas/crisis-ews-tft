FROM python:3.12-slim

WORKDIR /app

# Install system deps for compiled packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements/base.txt requirements/data.txt ./requirements/
RUN pip install --no-cache-dir -r requirements/data.txt

# Copy data pipeline code
COPY data/ ./data/
COPY scripts/ ./scripts/

ENTRYPOINT ["python", "-m", "data.pipelines.run_pipeline"]
CMD ["--task", "all"]
